# Merge the chosen settings into clients/mobile/.env.local; do not overwrite an existing env file.
# OSRM: full driving-route prefix. This is an example hostname, not a deployed service.
EXPO_PUBLIC_ROUTING_PROVIDER=osrm
EXPO_PUBLIC_ROUTING_ENDPOINT=https://routing.example.com/route/v1/driving/
# Native Valhalla alternative:
# EXPO_PUBLIC_ROUTING_PROVIDER=valhalla
# EXPO_PUBLIC_ROUTING_ENDPOINT=https://routing.example.com/
# Local debug builds only, with adb reverse configured for the selected port:
# EXPO_PUBLIC_ROUTING_ENDPOINT=http://127.0.0.1:5000/route/v1/driving/
# EXPO_PUBLIC_ROUTING_ENDPOINT=http://127.0.0.1:8002/
# EXPO_PUBLIC values are embedded in the app and are not secrets.
