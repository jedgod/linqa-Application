# DEMO keeps the current mock UI fully usable.
VITE_LINQA_RUNTIME_MODE=DEMO

# Used only in HYBRID or LIVE.
VITE_LINQA_API_URL=http://127.0.0.1:8088

# Any feature can be disabled explicitly.
VITE_FEATURE_ENCRYPTED_MESSAGING=true
VITE_FEATURE_ATTACHMENTS=true
VITE_FEATURE_VIDEO_MODES=true
VITE_FEATURE_LOCATION_EXCHANGE=true
VITE_FEATURE_BILLING_ENTITLEMENTS=true
