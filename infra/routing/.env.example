# Windows: Start-Routing.ps1 sets this to an absolute path on C:.
ROUTING_DATA_ROOT=../../.runtime/routing
OSRM_IMAGE=ghcr.io/project-osrm/osrm-backend:latest
VALHALLA_IMAGE=ghcr.io/valhalla/valhalla-scripted:latest
OSRM_PORT=5000
VALHALLA_PORT=8002
ROUTING_THREADS=2
# Start-Routing.ps1 resolves pulled tags to digests and writes an ignored lock file.
