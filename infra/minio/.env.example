# Copy to infra/minio/.env (which is git-ignored) and replace the secrets. Development only.
MINIO_IMAGE=minio/minio@sha256:REPLACE_WITH_THE_REVIEWED_DIGEST
MINIO_BIND_IP=127.0.0.1
MINIO_API_PORT=19000
MINIO_CONSOLE_PORT=19001
MINIO_ROOT_USER=REPLACE_WITH_LOCAL_ADMIN
MINIO_ROOT_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_SECRET
