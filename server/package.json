{
  "name": "@linqa/server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:encryption": "node --import ./node_modules/tsx/dist/loader.mjs --test ../tests/offline-metadata.test.ts ../tests/security-readiness.test.mjs && vitest run src/tests/offline-outbox-storage.test.mjs",
    "test:security:chat:db": "tsx ../scripts/run-chat-security-db.mjs",
    "security:readiness": "node ../scripts/security-check.mjs ../evidence/product-readiness.json",
    "test:security:chat": "vitest run src/tests/chat/route-security.test.ts src/tests/chat/realtime-security.test.ts src/tests/chat/shared-attachment.routes.test.ts src/tests/chats-inbox.route.test.ts src/tests/production-auth-policy.test.ts src/tests/chat/chat-v2.integration.test.ts src/tests/chat/thread-attachment.integration.test.ts src/tests/chat/session-lifecycle.test.ts src/tests/chat/session-revocation.integration.test.ts src/tests/chat/call-vault-security.test.ts src/tests/desktop-call-auth.test.ts",
    "db:migrate": "tsx src/db/migrate.ts",
    "dev:mint-ops-token": "tsx src/dev/mint-ops-access-token.ts",
    "db:cleanup": "tsx src/jobs/cleanup.ts",
    "jobs:status-video-expiry": "node --env-file-if-exists=.env --import tsx src/jobs/status-video-expiry.ts",
    "linqasend:workers": "tsx src/jobs/linqasend-workers.ts",
    "linqasend:test:wallet:db": "tsx ../scripts/run-wallet-db-tests.mjs",
    "linqasend:wallet:preflight": "node --env-file-if-exists=.env --import tsx src/jobs/wallet-provider-preflight.ts",
    "linqasend:wallet:verify-integration": "node --import tsx ../scripts/verify-integration-parity.ts",
    "linqasend:wallet:migrate": "node --env-file-if-exists=.env --import tsx src/jobs/wallet-schema-migrate.ts",
    "linqasend:wallet:register-custody": "node --env-file-if-exists=.env --import tsx src/jobs/wallet-register-custody.ts",
    "home:workers": "tsx src/jobs/home-workers.ts",
    "g5:materialize": "tsx src/ga/materialize-cli.ts",
    "g5:verify": "tsx src/ga/verify-ga-cli.ts",
    "final:verify": "tsx src/release-closure/verify-final-cli.ts",
    "release:unified-onboarding": "node ../scripts/unified-onboarding-release-gate.mjs",
    "home:test": "vitest run src/tests/home",
    "home:device:certify": "node ../scripts/certify-home-device.mjs",
    "home:evidence:collect": "node ../scripts/collect-home-release-evidence.mjs",
    "home:evidence:verify": "node ../scripts/verify-home-evidence-freshness.mjs",
    "home:providers:verify": "node ../scripts/verify-home-provider-redundancy.mjs",
    "home:release:gate": "node ../scripts/verify-home-release-gate.mjs",
    "chat:workers": "tsx src/jobs/chat-workers.ts",
    "countrylinqa:workers": "tsx src/jobs/countrylinqa-workers.ts",
    "chat:test": "vitest run src/tests/chat"
  },
  "dependencies": {
    "@aws-sdk/client-kms": "^3.1105.0",
    "@aws-sdk/client-s3": "^3.1105.0",
    "@aws-sdk/s3-request-presigner": "^3.1105.0",
    "@fastify/cors": "^10.0.0",
    "@fastify/helmet": "^13.0.0",
    "@fastify/rate-limit": "^10.0.0",
    "@fastify/websocket": "^11.0.0",
    "@simplewebauthn/server": "^13.3.2",
    "country-to-currency": "3.0.1",
    "fast-xml-parser": "^5.11.1",
    "fastify": "^5.12.5",
    "fastify-raw-body": "^6.0.1",
    "jose": "^6.0.0",
    "libphonenumber-js": "^1.13.10",
    "pg": "^8.13.0",
    "pino": "^9.0.0",
    "ws": "^8.18.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.1.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.11.0",
    "@types/ws": "^8.5.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "nanoid": "3.3.18"
  }
}
