    "@fastify/cors": "^10.0.0",
    "@fastify/helmet": "^13.0.0",
    "@fastify/rate-limit": "^10.0.0",
    "@fastify/websocket": "^11.0.0",
    "@simplewebauthn/server": "^13.3.2",
    "fastify": "^5.0.0",
    "jose": "^6.0.0",
    "libphonenumber-js": "^1.13.10",
    "pg": "^8.13.0",
    "pino": "^9.0.0",
    "ws": "^8.18.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.11.0",
