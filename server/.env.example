NODE_ENV=development
HOST=127.0.0.1
PORT=8080
DATABASE_URL=postgresql://linqa:linqa_dev_password@127.0.0.1:5432/linqa

# Shipped defaults are 8080 (API) and 5432 (Postgres) — do not change these.
# For local-only Windows port conflicts, set instead (see server/README_INTEGRATION.md):
#   LINQA_API_PORT=8088
#   LINQA_DATABASE_PORT=55432
JWT_ISSUER=https://auth.local.linqa
JWT_AUDIENCE=linqa-api
JWT_HS256_SECRET=replace-with-at-least-32-random-bytes
# Required as a pair in production. Store literal multiline PKCS#8/SPKI PEM values
# in the deployment secret manager. Local development uses HS256 tokens only.
# JWT_SIGNING_PRIVATE_KEY_PEM=-----BEGIN PRIVATE KEY-----...
# JWT_VERIFYING_PUBLIC_KEY_PEM=-----BEGIN PUBLIC KEY-----...
# Optional for verifying tokens issued by a separate identity provider.
# JWT_JWKS_URL=https://identity.example/.well-known/jwks.json
CONTACT_DISCOVERY_SECRET=replace-with-at-least-32-different-random-bytes
IP_HASH_SECRET=replace-with-another-independent-32-byte-secret
TOKEN_VAULT_KEY_BASE64=replace-with-a-base64-encoded-32-byte-key-value
TURN_SHARED_SECRET=replace-with-at-least-32-random-bytes
TURN_URLS=turn:127.0.0.1:3478?transport=udp,turn:127.0.0.1:3478?transport=tcp
CORS_ORIGINS=http://127.0.0.1:5173
DEVICE_CHALLENGE_TTL_SECONDS=300
ENVELOPE_TTL_SECONDS=2592000
MAX_ENVELOPE_BYTES=262144
DELIVERY_LEASE_SECONDS=60
LOG_LEVEL=info

# Required for CountryLinqa production readiness. The endpoint receives ?ip=
# and must return {"countryCode":"US"}; the bearer token is optional.
# COUNTRYLINQA_GEOIP_URL=https://geo.example/v1/country
# COUNTRYLINQA_GEOIP_TOKEN=replace-with-provider-token

# LinqaSend certified provider gateway. Both values are required together.
# The gateway implements KYC, compliance, funding, payout/reconciliation, and FX.
# LINQASEND_PROVIDER_URL=https://payments.example/linqa
# LINQASEND_PROVIDER_TOKEN=replace-with-provider-api-token
LINQASEND_WEBHOOK_TOLERANCE_SECONDS=300
