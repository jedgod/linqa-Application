NODE_ENV=development
# Biometric production enrollment requires a real platform-evidence verifier.
# Set both values through the deployment secret manager; production requires HTTPS.
# BIOMETRIC_ATTESTATION_URL=https://your-verifier-host/verify
# BIOMETRIC_ATTESTATION_TOKEN=your-verifier-service-credential
HOST=127.0.0.1
PORT=8080
DATABASE_URL=postgresql://linqa:linqa_dev_password@127.0.0.1:5432/linqa

# Shipped defaults are 8080 (API) and 5432 (Postgres) — do not change these.
# For local-only Windows port conflicts, set instead (see server/README_INTEGRATION.md):
#   LINQA_API_PORT=8088
#   LINQA_DATABASE_PORT=55432
JWT_ISSUER=https://auth.local.linqa
JWT_AUDIENCE=linqa-api
JWT_HS256_SECRET=replace-with-at-least-32-random-bytes
# Required as a pair in production. Store literal multiline PKCS#8/SPKI PEM values
# in the deployment secret manager. Local development uses HS256 tokens only.
# JWT_SIGNING_PRIVATE_KEY_PEM=-----BEGIN PRIVATE KEY-----...
# JWT_VERIFYING_PUBLIC_KEY_PEM=-----BEGIN PUBLIC KEY-----...
# Optional for verifying tokens issued by a separate identity provider.
# JWT_JWKS_URL=https://identity.example/.well-known/jwks.json
CONTACT_DISCOVERY_SECRET=replace-with-at-least-32-different-random-bytes
IP_HASH_SECRET=replace-with-another-independent-32-byte-secret
TOKEN_VAULT_KEY_BASE64=replace-with-a-base64-encoded-32-byte-key-value
TURN_SHARED_SECRET=replace-with-at-least-32-random-bytes
TURN_URLS=turn:127.0.0.1:3478?transport=udp,turn:127.0.0.1:3478?transport=tcp
CORS_ORIGINS=http://127.0.0.1:5173
DEVICE_CHALLENGE_TTL_SECONDS=300
ENVELOPE_TTL_SECONDS=2592000
MAX_ENVELOPE_BYTES=262144
DELIVERY_LEASE_SECONDS=60
LOG_LEVEL=info

# Required for CountryLinqa production readiness. The endpoint receives ?ip=
# and must return {"countryCode":"US"}; the bearer token is optional.
# COUNTRYLINQA_GEOIP_URL=https://geo.example/v1/country
# COUNTRYLINQA_GEOIP_TOKEN=replace-with-provider-token

# LinqaSend certified provider gateway. Both values are required together.
# The gateway implements KYC, compliance, funding, payout/reconciliation, and FX.
# LINQASEND_PROVIDER_URL=https://payments.example/linqa
# LINQASEND_PROVIDER_TOKEN=replace-with-provider-api-token
# Exact certified source and artifact identity. Required with the provider gateway.
# LINQASEND_RELEASE_GIT_SHA=0123456789abcdef0123456789abcdef01234567
# LINQASEND_ARTIFACT_SHA256=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
LINQASEND_WEBHOOK_TOLERANCE_SECONDS=300
# Money movement remains disabled unless every production gate is configured.
LINQASEND_MODE=SANDBOX_CERTIFICATION
LINQASEND_REAL_MONEY_ENABLED=false
LINQASEND_PUBLIC_ENROLLMENT=false
# Required as a pair for envelope-encrypted funding/payout references and webhook keys.
# LINQASEND_TOKEN_KMS_KEY_ID=arn:aws:kms:us-east-1:000000000000:key/replace-me
# LINQASEND_TOKEN_KMS_REGION=us-east-1
# Required in LIMITED_LAUNCH; must identify the one exact certified bank corridor.
# LINQASEND_LIMITED_LAUNCH_CORRIDOR_ID=00000000-0000-4000-8000-000000000000
LINQASEND_EXECUTION_LEASE_SECONDS=60
LINQASEND_WEBHOOK_MAX_AGE_SECONDS=300

# --- Linqa Home (Production Closure Pack v1.0 / Completion Pack v1.1) -------
# Cache tier. Optional: PostgreSQL is the authoritative durable cache and Home
# keeps working (degraded, reported on /health/home) when Redis is absent.
REDIS_URL=

# Primary news provider (GDELT DOC 2.0). Set to false only to take it out of
# rotation; the release gate blocks a promotion with the primary disabled.
HOME_NEWS_GDELT_ENABLED=true

# Secondary news provider. Required for release: Home must not depend on a
# single upstream. Must be HTTPS and return { "items": [...] }.
HOME_APPROVED_RSS_ENDPOINT=
HOME_APPROVED_RSS_TOKEN=

HOME_NEWS_TIMEOUT_MS=5500
HOME_NEWS_CACHE_FRESH_SECONDS=300
HOME_NEWS_CACHE_STALE_SECONDS=1800
HOME_NEWS_MAX_PER_PROVIDER=40
HOME_NEWS_FAILURE_THRESHOLD=3
HOME_NEWS_CIRCUIT_SECONDS=120
HOME_NEWS_BREAKING_WINDOW_MINUTES=90

HOME_FEED_SNAPSHOT_TTL=120
HOME_FEED_MAX_NEWS=20
HOME_FEED_MAX_LIVE_UPDATES=6
HOME_FEED_SNAPSHOT_RETENTION_DAYS=7

# Background worker cadence (npm run home:workers).
HOME_NEWS_REFRESH_INTERVAL_SECONDS=300
HOME_BREAKING_EXPIRY_INTERVAL_SECONDS=300
HOME_NEWS_REFRESH_MAX_COUNTRIES=25

# Release gate. Leave HOME_REQUIRE_DEVICE_EVIDENCE=true for any promotion:
# a passing CI build without matching physical-device evidence is not
# sufficient to promote Home.
HOME_REQUIRE_DEVICE_EVIDENCE=true
HOME_EVIDENCE_MAX_AGE_HOURS=72
LINQA_ANDROID_PACKAGE=com.linqa.mobile
LINQA_SERVER_ARTIFACT=
LINQA_ANDROID_APK=
LINQA_IOS_ARTIFACT=

# Exact trusted reverse-proxy IP addresses/CIDRs only; leave empty for direct access.
TRUSTED_PROXY_CIDRS=
# Optional chat AI image gateway. HTTPS JSON endpoint returning {images:[{base64,mime}]}.
# CHAT_AI_IMAGE_URL=https://image-provider.example/generate
# CHAT_AI_IMAGE_TOKEN=replace-with-provider-secret
